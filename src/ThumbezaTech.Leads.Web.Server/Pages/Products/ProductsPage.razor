@page "/products/list"

@*https://blazor.radzen.com/get-started*@

<section>
    <div class="container-fluid">
        <UseGet_products Context="product">

            <LoadingContent>
                <span class="h5">Fetching Products... Please wait</span>
            </LoadingContent>

            <ErrorContent>
                <p class="h5">Something went wrong...</p>
                <p class="text-warning">@product.First().Message</p>
            </ErrorContent>

            <ChildContent>
                <MudGrid>
                    @foreach (var item in product.List_products.Nodes)
                    {
                        <MudItem md="3">
                            <MudCard>
                                <MudCardHeader>
                                    <MudText>@item.Name</MudText>
                                </MudCardHeader>
                                <MudCardContent>
                                    <MudText>@item.Price.Currency</MudText>
                                    <MudText>@item.Price.Amount</MudText>
                                    <MudText>@item.Sku</MudText>
                                </MudCardContent>
                                <MudCardActions>
                                    <MudIconButton Icon="@Icons.Material.Filled.SwipeRightAlt" title="More"></MudIconButton>
                                </MudCardActions>
                            </MudCard>


                        </MudItem>
                    }
                </MudGrid>
            </ChildContent>
        </UseGet_products>
    </div>
</section>
